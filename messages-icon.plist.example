<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.messages-icon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/python@3.14/libexec/bin/python3</string>
        <string>/path/to/messages-icon/server.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Bind only to the address remote clients should use. A Tailscale IP
             keeps the server off the physical LAN with no auth needed;
             0.0.0.0 exposes it to every device on the LAN. -->
        <key>MESSAGES_ICON_BIND</key>
        <string>YOUR_TAILSCALE_IP</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/messages-icon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/messages-icon.log</string>
</dict>
</plist>
